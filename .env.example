# Mẫu biến môi trường. Chép thành `.env` (không bao giờ commit `.env`). Tên biến khớp CHÍNH XÁC trường settings:
# pydantic-settings bỏ qua âm thầm biến sai tên (extra="ignore"), nên gõ nhầm tên = dùng giá trị mặc định.
# Thêm biến mới ⇒ sửa file này trong cùng PR.

# --- Ứng dụng (src/core/settings.py) ---
APP_NAME=Agentfold
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Chỉ cho preview deployment đổi hostname. Neo vào tên dự án + team: ^https://app-[a-z0-9]+-team\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- CSDL ---
# Máy dev: SQLite hoặc Postgres trong docker compose. KHÔNG trỏ vào CSDL production.
DATABASE_URL=sqlite:///./data/app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SEC=10
DB_CONNECT_TIMEOUT_SEC=10

# --- Xác thực ---
# Production: ít nhất 32 ký tự, sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL_MIN=15

# --- Cửa ngõ LLM (src/llm/settings.py, tiền tố LLM_) ---
# offline = không gọi mạng (test, CI, máy chưa có khoá)
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SEC=20
LLM_MAX_ATTEMPTS=2

# --- Frontend (web/, nhúng lúc BUILD) ---
# Gốc API, KHÔNG kèm /api/v1. Trên Vercel đặt cho cả Production, Preview và Development.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Điều phối agent (tools/agentctl) ---
# Nhãn phiên ghi vào claim (mặc định: tên máy)
AGENTCTL_SESSION=
# off = tắt hook chặn ghi cho phiên hiện tại (chỉ người chủ phiên đặt, cho việc đã được duyệt)
AGENTCTL_HOOKS=on
