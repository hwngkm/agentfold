{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_write.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_shell.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/post_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/evidence_gate.py\" start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/_pyrun.sh -m tools.agentctl prime --offline",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/evidence_gate.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
